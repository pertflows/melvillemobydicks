# Supabase. Read at request time, so changing these needs a redeploy, not a rebuild.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Needed by scripts/import-legacy.ts and scripts/create-admin.ts.
SUPABASE_SECRET_KEY=

# Legacy site to migrate from.
LEGACY_BASE_URL=https://mobydicks.org

# NEXT_PUBLIC_ equivalents are still accepted as a fallback. They are inlined at
# build time, so prefer the names above unless something must run in the browser.
